# ---------- Shared ----------
# Postgres is only reachable on the internal compose network by default.
POSTGRES_USER_B=m_svc
POSTGRES_PASSWORD_B=your_password
POSTGRES_DB_B=members_db

POSTGRES_USER_A=c_svc
POSTGRES_PASSWORD_A=change_me_a
POSTGRES_DB_A=checkins_db

# ---------- Service B (Members) ----------
B_GRPC_PORT=50051

# ---------- Service A (CheckIns) ----------
A_GRPC_PORT=50052
A_MEMBERS_ADDR=service-b-members:50051
A_MEMBERS_TIMEOUT=2s
A_MEMBERS_MAX_ATTEMPTS=3
A_MEMBERS_BASE_BACKOFF=100ms
A_MEMBERS_MAX_BACKOFF=1s

# Circuit breaker
A_CB_MAX_REQUESTS=1
A_CB_INTERVAL=10s
A_CB_TIMEOUT=15s
A_CB_MIN_REQUESTS=3
A_CB_FAILURE_RATE=0.6

# ---------- Gateway ----------
GW_HTTP_PORT=8080
GW_MEMBERS_ADDR=service-b-members:50051
GW_CHECKINS_ADDR=service-a-checkins:50052
